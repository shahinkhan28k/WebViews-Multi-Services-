{
  "collections": {
    "linked_accounts": {
      "description": "Stores encrypted or secure references to linked Google accounts",
      "fields": {
        "email": "string",
        "name": "string",
        "picture": "string",
        "access_token": "string",
        "refresh_token": "string",
        "expiry_date": "number",
        "linked_at": "timestamp"
      }
    },
    "temp_messages": {
      "description": "Stores incoming emails for temporary addresses",
      "fields": {
        "to": "string",
        "from": "string",
        "subject": "string",
        "text": "string",
        "html": "string",
        "received_at": "timestamp"
      }
    }
  }
}
